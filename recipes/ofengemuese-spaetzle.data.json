  "steps": [
    {
      "id": "prep",
      "title": "Vorbereiten",
      "minutes": 10,
      "text": "Backofen auf 200 °C Umluft vorheizen. Kartoffeln gründlich waschen, trocknen und mit Schale in ca. 2 cm Stücke schneiden; optional Kürbis ebenfalls würfeln. Zwiebeln in Spalten, Paprika grob schneiden, Knoblauch in der Schale lassen. Frühlingszwiebeln in weiße und grüne Ringe teilen.",
      "imageId": "ingredients"
    },
    {
      "id": "roast1",
      "title": "Gemüse anrösten",
      "minutes": 20,
      "text": "Kartoffeln, Kürbis (optional), Zwiebeln und Knoblauch mit Öl und Gewürzen vermengen, auf Blech einlagig verteilen, 20 Minuten bei 200 °C Umluft rösten. Kartoffel-Schnittflächen nach unten.",
      "imageId": "tray"
    },
    {
      "id": "roast2",
      "title": "Paprika ergänzen",
      "minutes": 20,
      "text": "Paprikastücke nach 20 Minuten zugeben, alles wenden, weitere 15–20 Minuten rösten. Knoblauch anschließend ausdrücken.",
      "imageId": "tray"
    },
    {
      "id": "spaetzle",
      "title": "Spätzle kochen",
      "minutes": 10,
      "text": "Während der zweiten Röstphase Spätzle nach Packungsangabe in Salzwasser garen; 2–3 EL Kochwasser zurückhalten.",
      "parallelWith": "roast2"
    },
    {
      "id": "sauce",
      "title": "Knoblauch-Rahmsoße",
      "minutes": 6,
      "text": "Butter in Pfanne schmelzen, weiße Frühlingszwiebelteile 2 Minuten anschwitzen, optional Ingwer 30–60 Sekunden dazugeben. Gerösteten Knoblauch, Sahne und Gemüsebrühe zufügen; 3–4 Minuten leicht köcheln. Muskat, Salz und Pfeffer zugeben.",
      "imageId": "sauce"
    },
    {
      "id": "toss",
      "title": "Spätzle schwenken",
      "minutes": 2,
      "text": "Gegarte Spätzle in die Soße geben und 2 Minuten schwenken. Bei Bedarf mit etwas Kochwasser verdünnen."
    },
    {
      "id": "finish",
      "title": "Parmesan und Zitrone",
      "minutes": 1,
      "text": "Herd ausschalten, Parmesan unterrühren; erst danach Zitronensaft zugeben und abschmecken. Nicht mehr stark erhitzen."
    },
    {
      "id": "serve",
      "title": "Anrichten",
      "minutes": 2,
      "text": "Spätzle auf Teller verteilen, geröstetes Gemüse erst beim Anrichten darübergeben. Mit grünen Frühlingszwiebeln, Pfeffer und optional zurückbehaltenem Parmesan servieren.",
      "imageId": "hero"
    }
  ],
